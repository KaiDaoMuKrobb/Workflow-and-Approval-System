# Environment variables template for ExpenseFlow (placeholders only; never commit real secrets)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseflow?schema=public"
JWT_SECRET="replace-with-a-secure-secret-in-production"
NODE_ENV="development"

# Optional override for HttpOnly session cookie Secure flag ("true" in HTTPS production, "false" for local HTTP only)
COOKIE_SECURE="false"

# Set SEED_DEMO_DATA="true" only when seeding baseline demo accounts via `npm run db:seed`
SEED_DEMO_DATA="true"
DEMO_USER_PASSWORD="replace-with-local-demo-password"
